# ---- Target / CPU ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000

# ---- Flash / partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# 120 MHz flash and octal PSRAM: about 6% faster than 80 MHz (the renderer runs from
# flash and its data is in PSRAM). ESP-IDF marks octal PSRAM at 120 MHz as experimental:
# the timing is tuned at boot, and a large temperature change can make it fail. If the
# game crashes at random once warm, use CONFIG_ESPTOOLPY_FLASHFREQ_80M and
# CONFIG_SPIRAM_SPEED_80M (and delete sdkconfig / the build directory).
# esp32-quake (Sunton 8048S050): 120 MHz since the bounce buffer display driver
# (measured at 80 MHz: 29-42 fps in the demo).
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_SPI_FLASH_HPM_ENA=y
CONFIG_SPI_FLASH_HPM_DC_DISABLE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Caches: the renderer runs from flash/PSRAM through the caches ----
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# 32 kB data cache: the other 32 kB become internal RAM (needed by BLE + engine)
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- PSRAM (required: PAK block cache + model/skin cache) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- FAT on SD card ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=256

# ---- Bluetooth LE HID host (NimBLE) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
# esp_hid (HID host) is only built with the NimBLE "Services" menu, which needs the peripheral role
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
# a device that lost our bond (re-paired elsewhere) can pair again: the old bond is deleted
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_BT_CTRL_PINNED_TO_CORE_0=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# ---- Misc ----
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# esp32-quake (Sunton 8048S050): the USB-C port is a CH340 USB-UART bridge on UART0
# (GPIO43/44). The L2 uses CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y instead.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BT_NIMBLE_HID_SERVICE=y

# ---- Internal RAM savings (IRAM and DRAM share the same pool on the S3) ----
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# ---- esp32-quake: RGB panel (Sunton 8048S050) ----
# Bounce buffer mode (esp_display_rgb.c): the driver detects missed refills and
# restarts by itself. Forcing a restart in every vertical blank makes the picture
# jump vertically, so it stays off.
# CONFIG_LCD_RGB_RESTART_IN_VSYNC is not set

# ---- esp32-quake: Wi-Fi update mode (esp_update.c) ----
# Rollback: new firmware must confirm itself (Wi-Fi up) or the previous one returns
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Wi-Fi only runs in update mode: keep its code out of internal RAM, which the game needs
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
# CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION is not set
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Buffers that must stay in internal RAM: keep them few (that option alone raises the
# static RX buffers to 16 x 1.6 kB, which does not fit: esp_wifi_init ESP_ERR_NO_MEM).
# Firmware uploads do not need the throughput of AMPDU aggregation. In update mode the
# display also shrinks its internal buffers (esp_display_rgb.c, displayLowMemoryMode).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# (TX buffers: ESP-IDF forces the static type when Wi-Fi uses PSRAM)
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=12
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# browsers send long headers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
